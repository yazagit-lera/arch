#!/usr/bin/env bash
# SPDX-License-Identifier: 0BSD
# Post install
set -e -o pipefail

apply_settings() {
    gsettings set \
        org.gnome.settings-daemon.plugins.power sleep-inactive-ac-timeout 86400
    gsettings set \
        org.gnome.settings-daemon.plugins.power \
        sleep-inactive-battery-timeout 86400

    gsettings set org.gnome.desktop.interface cursor-blink false
    gsettings set org.gnome.desktop.interface color-scheme prefer-dark
    gsettings set org.gnome.desktop.interface gtk-theme Adwaita-dark

    gsettings set org.gnome.desktop.peripherals.keyboard repeat-interval 50
    gsettings set org.gnome.desktop.peripherals.keyboard delay 200
    gsettings set org.gnome.desktop.peripherals.mouse accel-profile flat
    gsettings set org.gnome.desktop.peripherals.mouse speed 1.0
    gsettings set \
        org.gnome.desktop.peripherals.touchpad disable-while-typing false
}

install_packages() {
    flatpak install flathub \
        com.brave.Browser com.discordapp.Discord \
        org.onlyoffice.desktopeditors org.telegram.desktop org.gnome.Loupe \
        org.vinegarhq.Sober --noninteractive
}

main() {
    apply_settings
    install_packages
}

main
