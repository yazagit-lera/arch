#!/usr/bin/env bash
# SPDX-License-Identifier: 0BSD
# adb file transfer
set -e -o pipefail

main() {
    local cmd="${1}"
    local file="${2}"
    local remote='/storage/emulated/0/aft'

    case "${cmd}" in
        push) adb push "${file}" "${remote}" ;;
        pull) adb pull "${remote}/${file}" ;;
        list) adb exec-out ls "${remote}" ;;
        *) exit 1 ;;
    esac
}

main "${1}" "${2}"
