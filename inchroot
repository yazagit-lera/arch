#!/usr/bin/env bash
#
# System tune in chroot
set -e -o pipefail

systemd_units() {
  systemctl enable \
    NetworkManager \
    systemd-timesyncd bluetooth fstrim.timer

  systemctl mask NetworkManager-wait-online
}

basic_setup() {
  local user_name="${1}"
  local password="${2}"

  ln -sf /usr/share/zoneinfo/Europe/Moscow /etc/localtime
  hwclock -w --utc

  usermod --lock -s /usr/bin/nologin root
  useradd --create-home -G wheel,video -s /usr/bin/bash "${user_name}"
  echo "${user_name}:${password}" | chpasswd

  pacman -Scc --noconfirm
}

main() {
  local user_name="${1}"
  local password="${2}"

  echo '- chroot'
  tar --uid 0 --gid 0 -x -f /mnt/cfg.tar -C /
  basic_setup "${user_name}" "${password}"
  systemd_units
  bootctl install --esp-path=/boot
}

main "${1}" "${2}"
