#!/usr/bin/env bash
#
# Arch linux install
set -e -o pipefail

usage() {
  echo "usage: ${0##*/} [-h] -n USERNAME -t TIMEZONE -l LAYOUT -d DISK"
  echo '  -f FIRMWARE'
  echo
  echo 'arch linux installer'
  echo
  echo 'options:'
  echo '  -h           show this help message and exit'
  echo '  -n USERNAME  specify username'
  echo '  -t TIMEZONE  specify timezone'
  echo '  -l LAYOUT    specify keyboard layout (e.g. us,ru)'
  echo '  -d DISK      specify target disk (e.g. sda)'
  echo '  -f FIRMWARE  specify a firmware list to install'
  echo "               (e.g. 'amdgpu realtek')"

  exit "${1}"
}

setup_pacman() {
  local pacmanconf
  pacmanconf='https://raw.githubusercontent.com/nedorazrab0/arch39/main/cfg'
  pacmanconf="${pacmanconf}/etc/pacman.conf"
  curl -f -o /etc/pacman.conf -- "${pacmanconf}"

  local mirrorconf
  mirrorconf='https://raw.githubusercontent.com/nedorazrab0/arch39/main/cfg'
  mirrorconf="${mirrorconf}/etc/pacman.d/mirrorlist"
  curl -f -o /etc/pacman.d/mirrorlist -- "${mirrorconf}"

  pacman-key --init
  pacman-key --populate archlinux
  pacman -Syy archlinux-keyring --needed --noconfirm
}

disk_partition() {
  local block='nvme0n1'
  local disk='/dev/nvme0n1'
  local efi='/dev/nvme0n1p2'
  local root='/dev/nvme0n1p2'

  mountpoint -q /mnt && umount -R /mnt

  echo 'none' > "/sys/block/${block}/queue/scheduler"
  echo '128' > "/sys/block/${block}/queue/nr_requests"
  echo '2' > "/sys/block/${block}/queue/rq_affinity"

  wipefs -a "${disk}"
  blkdiscard -vf "${disk}"
  sgdisk -Zo \
    -n1:0:+512M -t1:ef00 -c1:'EFI System Partition' \
    -n2:0:0 -t2:8304 -c2:'Arch Linux Root' -p "${disk}"

  mkfs.fat -F32 -n 'ESP' -v --codepage=437 "${efi}"
  mkfs.btrfs -fK -L 'archlinux' "${root}"

  local btrfs_options
  btrfs_options='noatime,nodiscard,nobarrier,commit=300,lazytime,ssd'
  btrfs_options+='compress=zstd:3'

  local fat_options
  fat_options='noexec,nodev,nosuid,noatime,fmask=0177,dmask=0077'
  fat_options+='lazytime,X-mount.mkdir=600'

  mount -t btrfs -v -o "${btrfs_options}" "${efi}" /mnt
  mount -t vfat -v -o  "${fat_options}" "${root}" /mnt/boot
}

pkg_strap() {
  pacstrap /mnt base linux booster amd-ucode \
    exfatprogs dosfstools android-tools \
    flatpak zram-generator nano python mandoc less \
    unzip polkit \
    ghostty doas \
    xdg-user-dirs \
    vulkan-radeon mesa vulkan-mesa-layers bluez{,-utils} \
    iptables adwaita-fonts pipewire{,-pulse,-jack} \
    gnome-shell ${fwpkglist}
}

setup_chroot() {
  local username="${1}"
  local password="${2}"
  local timezone="${3}"
  local layout="${4}"

  mount -o bind,ro -v /tmp/arch39 /mnt/mnt
  arch-chroot /mnt bash /mnt/inchroot -n "${username}" -p "${password}" \
    -t "${timezone}" -l "${layout}"
  umount -v /mnt/mnt
}

ask-password() {
  local password1
  password1="$(systemd-ask-password --echo=no \
    --emoji=no 'Enter a new password')"

  local password2
  password2="$(systemd-ask-password --echo=no \
    --emoji=no 'Retype the password')"

  if [[ "${password1}" == "${password2}" ]]; then
    echo "${password1}"
  else
    echo '! The passwords do not match' >&2
    exit 1
  fi
}

end() {
  umount -vR /mnt
  systemctl poweroff
}

main() {
  local OPTARG
  local arg

  # Parse args
  ((${#} == 0)) && usage 1 >&2
  while getopts 'hn:t:l:d:f:' arg; do
    case "${arg}" in
      n) local username="${OPTARG}" ;;
      t) local timezone="${OPTARG}" ;;
      l) local layout="${OPTARG}" ;;
      d) local blk="${OPTARG}" ;;
      f) local fwlist="${OPTARG}" ;;
      h) usage 0 ;;
      *) usage 1 >&2 ;;
    esac
  done

  local password
  password="$(ask-password)"

  setup_pacman
  disk_partition "${blk}"
  pkg_strap "${fwlist}"
  setup_chroot "${username}" "${password}" "${timezone}" "${layout}"
  end
}

main "${@}"
