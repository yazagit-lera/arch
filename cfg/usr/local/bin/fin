#!/usr/bin/env bash
# SPDX-License-Identifier: 0BSD
# Finish up the installation
set -e -o pipefail

main() {
  mkdir -p "${HOME}/ap2"
  gsettings set org.gnome.desktop.interface cursor-blink false
  gsettings set org.gnome.desktop.interface color-scheme prefer-dark
  gsettings set org.gnome.desktop.interface gtk-theme Adwaita-dark
  gsettings set org.gnome.desktop.peripherals.keyboard delay 200
  gsettings set org.gnome.desktop.peripherals.keyboard repeat-interval 50

  flatpak install flathub com.brave.Browser com.discordapp.Discord org.onlyoffice.desktopeditors org.telegram.desktop --noninteractive
}

main
