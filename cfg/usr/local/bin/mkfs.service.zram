#!/usr/bin/env bash
# SPDX-License-Identifier: 0BSD
# zram-generator
set -e -o pipefail

main() {
    local args="${@}"

    mke2fs -t ext4 -Fq -m0 -O ^has_journal,^metadata_csum,^metadata_csum_seed,^resize_inode,^extra_isize,sparse_super2,uninit_bg -E num_backup_sb=0,lazy_itable_init=1,assume_storage_prezeroed=1,nodiscard "${args}"
}

main "${@}"
